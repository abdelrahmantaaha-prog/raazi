{
  "manifest_version": 3,
  "name": "Raazi Inbox",
  "version": "0.5.0",
  "description": "Send the article you are reading — as you see it, signed in — to your Raazi inbox.",
  "permissions": ["activeTab", "scripting", "storage", "declarativeNetRequestWithHostAccess", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to Raazi inbox"
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "commands": {
    "clip": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Send this page to the Raazi inbox"
    },
    "gather": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "Gather the selected quote to your draft, and send the article to the inbox"
    }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
