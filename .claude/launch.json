{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "corpus",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev",
        "--port",
        "5400",
        "--hostname",
        "127.0.0.1"
      ],
      "port": 5400
    },
    {
      "name": "corpus-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "start",
        "--port",
        "5400",
        "--hostname",
        "127.0.0.1"
      ],
      "port": 5400
    },
    {
      "name": "corpus-check",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev",
        "--port",
        "5401",
        "--hostname",
        "127.0.0.1"
      ],
      "port": 5401
    },
    {
      "name": "corpus-film",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=video/film.env",
        "node_modules/next/dist/bin/next",
        "start",
        "--port",
        "5410",
        "--hostname",
        "127.0.0.1"
      ],
      "port": 5410
    },
    {
      "name": "corpus-dist",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=.claude/dist-check.env",
